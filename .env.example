# Copy to .env and fill in. .env is gitignored; never commit real values.
AWS_PROFILE=bie-portfolio
AWS_REGION=us-west-2
# Redshift Serverless from rack-delivery-pipeline (deployment window only).
REDSHIFT_WORKGROUP=
REDSHIFT_DATABASE=
# Read-only database user for NLQ: USAGE and SELECT on schema marts only.
NLQ_DB_USER=
# Bedrock model ids. Never hardcoded: DEV is a small, cheap model for iteration; the final
# reported eval uses BEDROCK_MODEL_ID.
BEDROCK_MODEL_ID=
BEDROCK_MODEL_ID_DEV=
